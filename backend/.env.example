# BuildTech backend — local development environment
# Copy this file to .env and adjust as needed. .env is gitignored.

APP_NAME=BuildTech
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database — used from Task 3 onward; declare here so config is complete
DATABASE_URL=sqlite:///./data/buildtech.db
